# Lab layout. Override any value from the environment.
PGBIN="${PGBIN:-$HOME/.local/src/pg17/pgsql/bin}"
LAB_DIR="${LAB_DIR:-$HOME/.pg-ops-lab}"   # cluster data lives outside the repo
PORT_A="${PORT_A:-55432}"
PORT_B="${PORT_B:-55433}"
PORT_RESTORE="${PORT_RESTORE:-55434}"
SEED_CUSTOMERS="${SEED_CUSTOMERS:-10000}"  # two accounts each
LOAD_CLIENTS="${LOAD_CLIENTS:-4}"
LOAD_RATE="${LOAD_RATE:-300}"         # transfers per second, roughly a busy bank's peak
